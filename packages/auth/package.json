{
  "name": "@madina/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test dist/rbac.test.js dist/passwords/scrypt.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./rbac": {
      "types": "./src/rbac.ts",
      "import": "./dist/rbac.js",
      "default": "./dist/rbac.js"
    }
  },
  "dependencies": {
    "@madina/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2"
  }
}
